@using SIGET.Models.ViewModel
@model ServiciosVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2"> @(Model.Servicios.Id != 0 ? "Editar" : "Crear") Servicio</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <input asp-for="Servicios.Id" hidden />
            <input asp-for="Servicios.ImageUrl" hidden />
            <div class="row">
                <div class="col-10">
                    <div class="border p-3">
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Servicios.Nombre" class="form-control border-0 shadow" />
                            <label asp-for="Servicios.Nombre" class="ms-2"></label>
                            <span asp-validation-for="Servicios.Nombre" class="text-danger"></span>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <select id="componentType" class="form-select border-0 shadow">
                                <option disabled selected>--Tipo de servicio--</option>
                                <option value="fisico">Hardware</option>
                                <option value="licencia">Software</option>
                            </select>
                            <label for="componentType" class="ms-2">Tipo de Componente</label>
                        </div>
                        
                        <div id="componentesFisicos" class="form-floating py-2 col-12 d-none">
                            <select asp-for="Servicios.ComponentesFisicosId" asp-items="@Model.ComponentesFisicosList" class="form-select border-0 shadow">
                                <option disabled selected>--Seleccionar Componente Físico--</option>
                            </select>
                            <label asp-for="Servicios.ComponentesFisicosId" class="ms-2"></label>
                            <span asp-validation-for="Servicios.ComponentesFisicosId" class="text-danger"></span>
                        </div>

                        <div id="licencias" class="form-floating py-2 col-12 d-none">
                            <select asp-for="Servicios.LicenciasId" asp-items="@Model.LicenciasList" class="form-select border-0 shadow">
                                <option disabled selected>--Seleccionar Licencia--</option>
                            </select>
                            <label asp-for="Servicios.LicenciasId" class="ms-2"></label>
                            <span asp-validation-for="Servicios.LicenciasId" class="text-danger"></span>
                        </div>

                        <div class="py-2 col-12">
                            <label asp-for="Servicios.Descripcion" class="ms-2 text-muted"></label>
                            <textarea asp-for="Servicios.Descripcion" class="form-control border-0 shadow"></textarea>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <input asp-for="Servicios.Precio" class="form-control border-0 shadow" />
                            <label asp-for="Servicios.Precio" class="ms-2"></label>
                            <span asp-validation-for="Servicios.Precio" class="text-danger"></span>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <label asp-for="Servicios.ImageUrl" class="p-0">Imagen</label>
                            <input type="file" name="file" class="form-control" />
                        </div>
                        
                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Servicios.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Editar</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Crear</button>
                                }
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Servicios" asp-action="Index" class="btn btn-outline-primary border  form-control">
                                    Atras
                                </a>
                            </div>
                        </div>

                    </div>
                </div>  
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/servicios.js"></script>
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: 'anchor autolink charmap codesample emoticons  lists   table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough |  align lineheight | numlist bullist indent outdent',
        });
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}