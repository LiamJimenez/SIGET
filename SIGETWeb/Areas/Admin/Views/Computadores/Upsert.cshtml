@using SIGET.Models.ViewModel
@model ComputadoresVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2"> @(Model.Computadores.Id != 0 ? "Editar" : "Crear") Computador</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <input asp-for="Computadores.Id" hidden />
            <div class="row">
                <div class="col-10">
                    <div class="border p-3">
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Computadores.Nombre" class="form-control border-0 shadow" />
                            <label asp-for="Computadores.Nombre" class="ms-2"></label>
                            <span asp-validation-for="Computadores.Nombre" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Computadores.Ip" class="form-control border-0 shadow" />
                            <label asp-for="Computadores.Ip" class="ms-2"></label>
                            <span asp-validation-for="Computadores.Ip" class="text-danger"></span>
                        </div>
                        
                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Computadores.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Editar</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Crear</button>
                                }
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Computadores" asp-action="Index" class="btn btn-outline-primary border form-control">
                                    Atras
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </form>
    </div>
</div>