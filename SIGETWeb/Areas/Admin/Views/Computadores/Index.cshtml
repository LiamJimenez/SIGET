@using SIGET.Models
@model IEnumerable<Computadores>

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Listado de Computadores</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Computadores" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>  Agregar Computador
                </a>
            </div>
        </div>

        <table id="computadorTabla" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Ip</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Nombre</td>
                        <td>@obj.Ip</td>
                        <th class="text-center">
                            @if (@obj.Estado)
                            {
                                <span class="circle green"></span>
                            }
                            else
                            {
                                <span class="circle red"></span>
                            }
                        </th>

                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a onclick="Delete(@obj.Id)" class="btn btn-danger mx-2">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/computadores.js"></script>
}