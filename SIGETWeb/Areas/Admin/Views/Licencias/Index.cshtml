@using SIGET.Models

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Software</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
           
            <div class="custom-switch">
                <input type="checkbox" id="switchComponentes" class="custom-switch-input">
                <label for="switchComponentes" class="custom-switch-label"></label>
                <span class="custom-switch-description">Hardware</span>
            </div>
            
            <a asp-controller="Licencias" asp-action="Upsert" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Agregar Licencia
            </a>
        </div>

        <table id="licenciaTabla" class="table table-bordered table-striped" style="width:100%">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Nombre</th>
                    <th>Fecha de Expiracion</th>
                    <th>Fecha de Renovacion</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Nombre</td>
                        <td>@obj.FechaExpiracion</td>
                        <td>@obj.FechaRenovacion</td>
                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Licencias" asp-action="Detalles" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                    <i class="bi bi-person-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/licencias.js"></script>
    <script>
        document.getElementById('switchComponentes').addEventListener('change', function () {
            if (this.checked) {
                window.location.href = '@Url.Action("Index", "ComponentesFisicos")';
            }
        }); 
    </script> 
}