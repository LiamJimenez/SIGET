@model SIGET.Models.Licencias

@{
    ViewData["Title"] = "Licencias";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card collaborator-card">
                @if (Model.ImageUrl != null)
                {
                    <div class="card-header text-center collaborator-header">
                        <img src="@Model.ImageUrl" class="collaborator-image img-fluid " alt="Imagen de la licencia" style="max-width: 150px; height: auto;" />
                    </div>
                }
                
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">Información de la Licencia</h4>
                    <dl class="row">
                        <dt class="col-sm-4 collaborator-label">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4 collaborator-label">Fecha de Expiracion:</dt>
                        <dd class="col-sm-8">@Model.FechaExpiracion</dd>

                        <dt class="col-sm-4 collaborator-label">Fecha de Renovacion:</dt>
                        <dd class="col-sm-8">@Model.FechaRenovacion</dd>
                    </dl>
                </div>
                <div class="card-footer text-center collaborator-footer">
                    <div class="btn-group" role="group" aria-label="Acciones">
                        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary mx-2">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a href="javascript:void(0);" onclick="Delete(@Model.Id);" class="btn btn-danger mx-2"><i class="bi bi-trash3"></i> Eliminar</a>
                        <a asp-controller="Licencias" asp-action="Index" class="btn btn-outline-secondary mx-2">
                            Regresar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/licencias.js"></script>
}