@using SIGET.Models

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-dark py-2">Listado de Componentes</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="ComponentesFisicos" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>  Agregar Componente
                </a>
            </div>
        </div>

        <table id="MiTabla" class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr>
                        <td>@obj.Nombre</td>
                        <td>@obj.Cantidad</td>

                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="ComponentesFisicos" asp-action="Detalles" asp-route-id="@obj.Id" class="btn btn-primary mx-2">
                                    <i class="bi bi-person-fill-exclamation"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
}