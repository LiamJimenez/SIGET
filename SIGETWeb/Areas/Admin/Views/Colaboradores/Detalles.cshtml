@model SIGET.Models.Colaboradores

@{
    ViewData["Title"] = "Detalles del Colaborador";
}

<h2>Detalles del Colaborador</h2>

@if (Model.ImageUrl != null)
{
    <div class="form-group">
        <img src="@Model.ImageUrl" height="100" />
    </div>
}

<div class="form-group">
    <label>Nombre:</label>
    <p>@Model.Nombre</p>
</div>
<div class="form-group">
    <label>Dirección:</label>
    <p>@Model.Direccion</p>
</div>
<div class="form-group">
    <label>Teléfono:</label>
    <p>@Model.Telefono</p>
</div>
<div class="form-group">
    <label>Correo:</label>
    <p>@Model.Correo</p>
</div>
<div class="form-group">
    <label>Área:</label>
    <p>@Model.Area</p>
</div>

<div class="form-group">
    <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary mx-2"><i class="bi bi-pencil-square"></i></a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash-fill"></i></a>
    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
</div>


